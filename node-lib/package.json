{
  "name": "duration-api",
  "version": "1.0.0",
  "description": "Extract duration from media files and SCORM packages",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "durationapi": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js serve",
