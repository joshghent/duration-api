{
  "name": "duration-api",
  "version": "1.0.0",
  "description": "Extract duration from media files and SCORM packages via ffprobe. Supports video, audio, and SCORM 1.1/1.2/2004/cmi5 e-learning packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshghent/duration-api.git"
  },
  "keywords": [
    "duration",
    "ffprobe",
    "ffmpeg",
    "media",
    "video",
    "audio",
    "scorm",
    "cmi5",
    "e-learning",
    "lms"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "durationapi": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js serve",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
